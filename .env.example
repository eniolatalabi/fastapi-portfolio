# Database: provide EITHER a full URL (typical on Render)...
DATABASE_URL=
# ...OR all five discrete values (typical locally). One source is required.
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_NAME=social_media
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# JWT signing
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-force protection on /login, slowapi notation
LOGIN_RATE_LIMIT=5/minute

# Comma-separated allowlist of browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
